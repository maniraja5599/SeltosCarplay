<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- 1. Top Header & Search Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/app_logo" />

        <!-- Address Bar Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_car_hud"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <EditText
                android:id="@+id/etSearchOrUrl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri|textWebEditText"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Google Voice Search Button -->
            <ImageButton
                android:id="@+id/btnVoiceSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voice Search"
                android:src="@drawable/ic_mic"
                app:tint="@color/accent" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reload"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/loadingProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/accent"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- 2. Main Content Frame (WebView + Home Grid) -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loadingProgress">

        <!-- Active Phone WebKit (Background-Safe) -->
        <com.seltos.kiabrowser.BackgroundWebView
            android:id="@+id/mainWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Home Favorites Overlay -->
        <ScrollView
            android:id="@+id/homeFavoritesView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Logo & Brand Header -->
                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/app_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Kia Browser"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Android Auto &amp; Kia Seltos Edition"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Car Status Pill -->
                <LinearLayout
                    android:id="@+id/layoutCarStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_shortcut_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_directions_car"
                        app:tint="@color/accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCarStatusTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Car Display Ready"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCarStatusSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Plug into car USB / Wireless Android Auto"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Shortcuts Section Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:text="FAVORITES &amp; STREAMING"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Grid of Shortcuts -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignMargins"
                    android:columnCount="3"
                    android:rowCount="3"
                    android:useDefaultMargins="true">

                    <!-- YouTube -->
                    <LinearLayout
                        android:id="@+id/cardYouTube"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/bg_shortcut_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▶"
                            android:textColor="@color/youtube_red"
                            android:textSize="26sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="YouTube"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Hotstar -->
                    <LinearLayout
                        android:id="@+id/cardHotstar"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/bg_shortcut_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★"
                            android:textColor="#3B82F6"
                            android:textSize="26sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Hotstar"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Netflix -->
                    <LinearLayout
                        android:id="@+id/cardNetflix"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/bg_shortcut_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="N"
                            android:textColor="#E50914"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Netflix"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- JioCinema -->
                    <LinearLayout
                        android:id="@+id/cardJioCinema"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/bg_shortcut_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎬"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="JioCinema"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Zee5 -->
                    <LinearLayout
                        android:id="@+id/cardZee5"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/bg_shortcut_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Z5"
                            android:textColor="#A855F7"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Zee5"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Spotify -->
                    <LinearLayout
                        android:id="@+id/cardSpotify"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/bg_shortcut_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="♫"
                            android:textColor="#10B981"
                            android:textSize="26sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Spotify"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Cricbuzz -->
                    <LinearLayout
                        android:id="@+id/cardCricbuzz"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/bg_shortcut_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏏"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Cricbuzz"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Google Maps -->
                    <LinearLayout
                        android:id="@+id/cardMaps"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/bg_shortcut_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Maps"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Fast.com Speedtest -->
                    <LinearLayout
                        android:id="@+id/cardFast"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/bg_shortcut_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Fast.com"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </GridLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 3. Bottom Navigation Toolbar (Horizontal Scrolling) -->
    <HorizontalScrollView
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:background="@color/surface_dark"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/bottomBarContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <!-- 1. Play / Pause (First & Prominent) -->
            <ImageButton
                android:id="@+id/btnNavPlayPause"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_circle_play"
                android:contentDescription="Play/Pause"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                app:tint="@color/background_dark" />

            <!-- 2. Previous Video -->
            <ImageButton
                android:id="@+id/btnNavPrevious"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous Track"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/text_primary" />

            <!-- 3. Seek -5s -->
            <Button
                android:id="@+id/btnNavRewind5"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:minWidth="48dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:paddingHorizontal="6dp"
                android:text="-5s"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 4. Seek +5s -->
            <Button
                android:id="@+id/btnNavForward5"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:minWidth="48dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:paddingHorizontal="6dp"
                android:text="+5s"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 5. Next Video -->
            <ImageButton
                android:id="@+id/btnNavNext"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next Track"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/text_primary" />

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="6dp"
                android:background="@color/divider" />

            <!-- 6. Home -->
            <ImageButton
                android:id="@+id/btnNavHome"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Home"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home"
                app:tint="@color/accent" />

            <!-- 7. Web Back -->
            <ImageButton
                android:id="@+id/btnNavBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_secondary" />

            <!-- 8. Web Forward -->
            <ImageButton
                android:id="@+id/btnNavForward"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Forward"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/text_secondary" />

            <!-- 9. Reload -->
            <ImageButton
                android:id="@+id/btnNavReload"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reload"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh"
                app:tint="@color/text_secondary" />

            <!-- 10. Desktop Mode Toggle -->
            <ImageButton
                android:id="@+id/btnToggleDesktop"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Desktop Mode"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_desktop_windows"
                app:tint="@color/text_secondary" />

            <!-- 11. AdBlock Shield Toggle -->
            <ImageButton
                android:id="@+id/btnToggleAdBlock"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ad Blocker"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shield"
                app:tint="@color/accent" />

            <!-- 12. Fullscreen Toggle -->
            <ImageButton
                android:id="@+id/btnToggleFullscreen"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Fullscreen"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_fullscreen"
                app:tint="@color/text_secondary" />

        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
